          setPersonalExpenses(data.personalExpenses);
          setFixedExpenses(data.fixedExpenses);
          setThirdPartyExpenses(data.thirdPartyExpenses);
          setBaseIncome(data.baseIncome);
          setExtraIncome(data.extraIncome);
        }
      });
