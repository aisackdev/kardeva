# docker-compose.prod.yml
services:
  postgres-db:
    image: postgres:15-alpine
    container_name: kardeva_postgres_prod
    restart: always
    environment:
      POSTGRES_USER: ${DB_USER:-kardeva_admin}
      POSTGRES_PASSWORD: ${DB_PASS:-rootless123}
      POSTGRES_DB: ${DB_NAME:-kardeva_db}
    volumes:
      - postgres_data_prod:/var/lib/postgresql/data
  adminer:
    image: adminer
    container_name: kardeva_adminer_prod
    restart: always

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile.prod
    container_name: kardeva_backend_prod
    restart: always
    depends_on:
      - postgres-db
    environment:
      - DB_USER=${DB_USER:-kardeva_admin}
      - DB_PASSWORD=${DB_PASS:-rootless123}
      - DB_NAME=${DB_NAME:-kardeva_db}
      - DB_HOST=postgres-db
      - DB_PORT=5432
      - ADMIN_USER=${ADMIN_USER}
      - ADMIN_PASS=${ADMIN_PASS}
      - JWT_SECRET=${JWT_SECRET}
      - BOT_API_KEY=${BOT_API_KEY}

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile.prod
      args:
        - VITE_API_URL=${VITE_API_URL}
    container_name: kardeva_frontend_prod
    restart: always

  # Cloudflare Tunnel Service
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: kardeva_tunnel
    restart: always
    # We pass the token we got from the Cloudflare Dashboard
    command: tunnel run
    environment:
      - TUNNEL_TOKEN=${CLOUDFLARE_TOKEN}
    depends_on:
      - frontend
      - backend

volumes:
  postgres_data_prod:
