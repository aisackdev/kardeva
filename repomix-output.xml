</file>

<file path="frontend/Dockerfile.prod">
# STAGE 1: Build the React Application
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# We must pass the API URL during the build process for Vite to bake it into the HTML
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# STAGE 2: Serve the compiled app with Nginx
FROM nginx:alpine
# Copy the built 'dist' folder from Stage 1 into Nginx's public folder
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
</file>

